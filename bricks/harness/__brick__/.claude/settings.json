{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__dart",
      "Bash(dart format:*)",
      "Bash(fvm dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(fvm dart analyze:*)",
      "Bash(flutter analyze:*)",
      "Bash(fvm flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(fvm flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(fvm flutter pub get)",
      "Bash(dart run custom_lint)",
      "Bash(fvm dart run custom_lint)",
      "Bash(dart run scripts/agent/verify.dart:*)",
      "Bash(fvm dart run scripts/agent/verify.dart:*)",
      "Bash(dart run scripts/agent/snapshot.dart)",
      "Bash(fvm dart run scripts/agent/snapshot.dart)",
      "Bash(dart run scripts/agent/wire_route.dart:*)",
      "Bash(fvm dart run scripts/agent/wire_route.dart:*)",
      "Bash(dart run scripts/agent/learn.dart:*)",
      "Bash(fvm dart run scripts/agent/learn.dart:*)",
      "Bash(mason make bloc:*)",
      "Bash(fvm exec mason make bloc:*)",
      "Bash(bash scripts/agent/verify.sh:*)",
      "Bash(powershell -File scripts/agent/verify.ps1:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)"
    ]
  },
  "enableAllProjectMcpServers": true
}
