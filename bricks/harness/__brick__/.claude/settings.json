{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__dart",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get)",
      "Bash(dart run custom_lint)",
      "Bash(dart run scripts/agent/verify.dart:*)",
      "Bash(dart run scripts/agent/snapshot.dart)",
      "Bash(dart run scripts/agent/wire_route.dart:*)",
      "Bash(mason make bloc:*)",
      "Bash(bash scripts/agent/verify.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dart \"$CLAUDE_PROJECT_DIR/scripts/agent/on_edit.dart\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
